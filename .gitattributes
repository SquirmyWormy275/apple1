*.img filter=lfs diff=lfs merge=lfs -text
# Reproducible teaching sources and retained transcripts use LF across checkouts.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.hex text eol=lf
docs/textbook/**/*.txt text eol=lf
docs/textbook/native/evidence/**/*.source -text
firmware/vendor/110REV03/*.spin text eol=lf
firmware/vendor/110REV03/_README_.txt text eol=lf
# These two upstream files are CRLF byte artifacts; provenance hashes require
# preserving their recorded checkout representation on every platform.
firmware/vendor/110REV03/Serial_IO.spin text eol=crlf
"firmware/vendor/110REV03/replica 110REV03.spin" text eol=crlf
