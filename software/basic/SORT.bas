10 DIM A(5)
20 A(1)=5:A(2)=3:A(3)=1:A(4)=4:A(5)=2
30 P=0:C=0:W=0
40 S=0:P=P+1
50 FOR I=1 TO 4
60 C=C+1
70 IF A(I)<=A(I+1) THEN 100
80 T=A(I):A(I)=A(I+1):A(I+1)=T
90 S=S+1:W=W+1
100 NEXT I
110 PRINT "PASS ";P;" SWAPS ";S
120 FOR I=1 TO 5
130 PRINT A(I);" ";
140 NEXT I
150 PRINT
160 IF S>0 THEN 40
170 PRINT "COMPARISONS ";C;" SWAPS ";W
180 END
