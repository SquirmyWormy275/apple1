{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEURAL1 cell checkpoint",
  "type": "object",
  "required": ["schema_version", "cell_id", "generation", "status", "snapshot_sha256", "snapshot_path", "transcript_sha256", "token_use", "errors", "updated_at"],
  "properties": {
    "schema_version": {"const": "neural1-checkpoint-0.1"},
    "cell_id": {"type": "string", "pattern": "^N1-CELL-[0-9A-F]{16}$"},
    "generation": {"type": "integer", "minimum": 0},
    "status": {"enum": ["RUNNING", "COMPLETED", "CANCELLED"]},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token_use": {"type": "integer", "minimum": 0},
    "errors": {"type": "array"},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
